# Public SDK keys only. Never put secret RevenueCat keys here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_POSTHOG_TOKEN=
# Disabled unless explicitly enabled. Internal/dev builds must use test.
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_ANALYTICS_ENV=test
# Configure entitlement ssak_plus and a non-consumable lifetime package
# in the current RevenueCat offering before testing on real devices.
