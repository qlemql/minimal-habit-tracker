{
  "name": "minimal-habit-tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview-web.cjs",
    "review": "node scripts/review-preview.cjs",
    "store:assets": "node scripts/store-assets.cjs",
    "brand:assets": "node scripts/brand-assets.cjs",
    "legal:build": "node scripts/legal-site.cjs",
    "release:check": "node scripts/release-check.cjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.34",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "rn-emoji-keyboard": "^1.7.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.1.0",
    "@xmldom/xmldom": "^0.8.15",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "11.1.1",
