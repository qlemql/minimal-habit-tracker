{
  "expo": {
    "name": "Ssak: Habit Tracker",
    "slug": "minimal-habit-tracker",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "web": { "favicon": "./assets/favicon.png" },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "minimal-habit-tracker",
    "locales": {
      "ko": "./locales/ios/ko.json",
      "en": "./locales/ios/en.json",
      "ja": "./locales/ios/ja.json",
      "zh-TW": "./locales/ios/zh-TW.json"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qlemql.minimalhabittracker",
      "buildNumber": "13",
      "appleTeamId": "5R27CJ6382",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.qlemql.minimalhabittracker"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "ko",
          "en",
          "ja",
          "zh-TW"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#315E4C",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.qlemql.minimalhabittracker",
      "versionCode": 11,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "./plugins/withSharedDefaults",
      "./plugins/withAndroidWidget",
      "./plugins/withAppNameI18n",
      "./plugins/withWindowsCmakePaths",
      "expo-localization",
      ["expo-splash-screen", {
        "image": "./assets/splash-icon.png",
        "imageWidth": 96,
        "resizeMode": "contain",
        "backgroundColor": "#F7F7F2"
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "132e673c-2e4b-410b-a486-6e2ba9d4d0df",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.qlemql.minimalhabittracker.widget",
                  "targetName": "HabitWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.qlemql.minimalhabittracker"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "router": {}
    },
    "owner": "daniel_hyun"
  }
}
