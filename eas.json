{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "node": "22.14.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ANALYTICS_ENABLED": "false",
        "EXPO_PUBLIC_ANALYTICS_ENV": "test"
      }
    },
    "preview": {
      "node": "22.14.0",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ANALYTICS_ENABLED": "false",
        "EXPO_PUBLIC_ANALYTICS_ENV": "test"
      }
    },
    "preview-device": {
      "node": "22.14.0",
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ANALYTICS_ENABLED": "false",
        "EXPO_PUBLIC_ANALYTICS_ENV": "test"
      }
    },
    "production": {
      "node": "22.14.0",
      "environment": "production",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ANALYTICS_ENABLED": "true",
        "EXPO_PUBLIC_ANALYTICS_ENV": "production"
      }
    },
    "analytics-qa": {
      "extends": "preview-device",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ANALYTICS_ENABLED": "true",
        "EXPO_PUBLIC_ANALYTICS_ENV": "test"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6762334017",
        "appleTeamId": "5R27CJ6382"
      }
    }
  }
}
